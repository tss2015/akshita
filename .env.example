API_ID=123456
API_HASH=replace_me
BOT_TOKEN=replace_me
OWNER_ID=123456789
# Comma-separated user session strings, 1 to 10. Never share these values.
ASSISTANT_SESSIONS=replace_me
DATABASE_URL=sqlite+aiosqlite:///./akshita.db
MAX_QUEUE=100
EXTRACTION_CONCURRENCY=3
VIDEO_ENABLED=false
LOG_LEVEL=INFO
# Alternative to ASSISTANT_SESSIONS (recommended with a separate secret store):
# ASSISTANT_SESSIONS_FILE=/run/secrets/assistant-sessions.enc
# ASSISTANT_KEY=replace_with_fernet_key

# Optional: absolute path to a private Netscape-format YouTube cookies file.
# Leave unset for anonymous YouTube access.
# YTDLP_COOKIES_FILE=/etc/akshita/youtube-cookies.txt
