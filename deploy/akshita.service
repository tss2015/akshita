[Unit]
Description=AKSHITA MUSIC Telegram streaming bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akshita
Group=akshita
WorkingDirectory=/opt/akshita
EnvironmentFile=/etc/akshita/akshita.env
ExecStart=/opt/akshita/.venv/bin/python -m akshita
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/akshita

[Install]
WantedBy=multi-user.target
